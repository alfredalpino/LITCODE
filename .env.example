# =============================================================================
# NEXT_PUBLIC_SITE_URL — REQUIRED for correct SEO / OG / sitemap
# =============================================================================
# Canonical public origin. No trailing slash.
#
# Local development:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Netlify (Production + Preview as needed):
#   Site configuration → Environment variables → set to the REAL origin users open
#   e.g. https://your-site.netlify.app  OR  https://your-custom-domain.com
#
# The value below is a PLACEHOLDER only. Replace it before public marketing launch.
# Do not assume litcode.dev resolves until you own/configure that domain.
# Rebuild / redeploy after changing this var (it is baked into the client bundle).
NEXT_PUBLIC_SITE_URL=https://litcode.dev

# Optional: POST JSON learning events from the browser (see src/lib/analytics.ts).
# Leave unset for local-first / no analytics requests.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=
