# Public defaults for local development. No secrets.
# Copy to .env.local and replace values before a public deploy.
# Next.js loads .env.local automatically and does not load this file.

NODE_ENV=development

# Canonical origin. No trailing slash.
# Local: http://localhost:3000
# Production: your real host, then rebuild (this value is baked into the client).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Judge0-compatible execute API used by /api/execute.
# Public CE is fine for local practice. Point this at your own instance in production.
JUDGE0_URL=https://ce.judge0.com

# Optional. Leave empty unless your Judge0 instance requires X-Auth-Token.
JUDGE0_AUTH_TOKEN=

# Optional absolute origin the server uses when it calls itself.
# Browser calls use a relative /api/execute URL and ignore this.
LITCODE_EXECUTE_URL=http://127.0.0.1:3000

# Optional. Leave empty to keep analytics local-only (see src/lib/analytics.ts).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Optional Sentry-compatible DSN. Empty disables remote error tracking.
SENTRY_DSN=

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
