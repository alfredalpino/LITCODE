{
  "name": "typescript-development-laboratory",
  "version": "0.1.0",
  "description": "Learn-by-doing TypeScript laboratory — type system, compiler, production engineering, interviews",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.emit.json",
    "clean": "rm -rf dist",
    "lab:00": "tsx 00-typescript-runtime-boundary/experiments/01-greet.ts",
    "lab:00:emit": "tsc -p 00-typescript-runtime-boundary/tsconfig.emit.json && node dist/00-typescript-runtime-boundary/experiments/01-greet.js",
    "lab:01": "tsx 01-toolchain/experiments/01-verify-toolchain.ts",
    "lab:02": "tsx 02-basic-types/experiments/01-primitives-exist.ts",
    "lab:03": "tsx 03-type-inference/experiments/01-const-vs-let.ts",
    "predict": "echo 'Open predict-the-type/ and write answers before revealing'"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "typescript",
    "learning",
    "laboratory",
    "type-system",
    "compiler"
  ],
  "license": "UNLICENSED"
}
