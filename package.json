{
  "name": "litcode",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "companies:gen": "node scripts/build-company-packs.mjs",
    "dsa:gen": "node scripts/generate-dsa-bank.mjs",
    "predev": "npm run sync && npm run companies:gen && npm run dsa:gen",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "npm run sync && npm run companies:gen && npm run dsa:gen",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/run-tests.mjs --scripts-only",
    "test:unit": "vitest run",
    "test:scripts": "node scripts/run-tests.mjs --scripts-only",
    "test:coverage": "vitest run --coverage",
    "dsa:phase6": "node scripts/phase6-build-judged-bank.mjs && npm run dsa:gen",
    "test:runners": "node scripts/smoke-runners.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@netlify/plugin-nextjs": "^5.15.9",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.5",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "next": "16.3.7",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint-config-next": "16.3.7",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
