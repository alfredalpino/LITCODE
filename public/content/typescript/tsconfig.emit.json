{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false
  },
  "include": [
    "00-typescript-runtime-boundary/experiments/**/*.ts",
    "01-toolchain/experiments/**/*.ts",
    "02-basic-types/experiments/**/*.ts",
    "03-type-inference/experiments/**/*.ts"
  ],
  "exclude": [
    "**/challenges/**",
    "**/solutions/**",
    "dist",
    "node_modules"
  ]
}
